# Server-only URL for the deployed OmniFlow Control Plane.
# Production rejects plaintext HTTP; use an HTTPS origin without /api/v1.
OMNIFLOW_CONTROL_PLANE_URL=https://api.example.com

# Optional Meta Graph settings. Workspace Instagram access tokens, app
# secrets and webhook verify tokens belong in the signed-in portal database;
# these values only select the Graph host/version or provide a controlled
# app-secret fallback for webhook verification.
OF_META_GRAPH_BASE_URL=https://graph.facebook.com
OF_META_GRAPH_VERSION=v21.0
OF_INSTAGRAM_APP_SECRET=

# Existing marketing admin/CMS configuration (do not commit real values).
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# §260 website analytics (server only). OF_ANALYTICS_SALT: any long random text; it is
# mixed into the daily visitor hash. CRON_SECRET: the same value Vercel Cron sends as
# "Bearer <value>" to /api/omniflow/cron/site-analytics (daily retention job).
OF_ANALYTICS_SALT=replace-with-long-random-text
CRON_SECRET=replace-with-long-random-text
