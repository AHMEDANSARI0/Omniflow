# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
__pycache__/
*.py[cod]

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit only the secret-free example)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.pre_*.bak

# bot runtime + local accident backups (never commit)
/whatsapp_sessions/
/src/whatsapp_session/
/logs/
/src/logs/
/hide/
/Omniflow/
*.dir_conflict.bak/

# Nested CP repo lives on the laptop bot root; never track it in the website repo.
OmniFlow-Control-Plane/
/patchers
/hide
/.connector_node.env
.connector_node.env

# §264 GitHub cleanup: local-only junk that must never be committed.
# These were swept into git by a bulk commit once; they are untracked again
# (git rm --cached) and stay out with these rules.
/venv/
/whatsapp_session/
/_archive/
/backups/
/runtime_locks/
/data/
/.agents/
/verify-script/
