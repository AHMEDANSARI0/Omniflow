import sys
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parent
SRC_DIR = PROJECT_ROOT / "src"

if str(SRC_DIR) not in sys.path:
    sys.path.insert(0, str(SRC_DIR))

from channels import (  # noqa: E402
    ChannelAccount,
    WhatsAppWebAdapter,
)


class FakeBurstBot:
    def __init__(self):
        self.started = False
        self.page = None
        self.current_chat_name = "Burst Customer"
        self.visible_messages = [
            self.message(
                "startup-old",
                "lid:burst-customer",
                "Old startup message",
                "inbound",
            )
        ]
        self.pending_unread_chat = None
        self.last_unread_count = 1

    @staticmethod
    def message(
        message_id,
        chat_identifier,
        text,
        direction="inbound",
        kind="text",
    ):
        return {
            "id": message_id,
            "chat_identifier": chat_identifier,
            "text": text,
            "kind": kind,
            "direction": direction,
        }

    def start(self):
        self.started = True

    def open_whatsapp(self, url):
        return None

    def stop(self):
        self.started = False

    def get_current_chat_name(self):
        return self.current_chat_name

    def get_visible_chat_messages(
        self,
        fallback_chat_identifier="",
        limit=100
    ):
        messages = [
            dict(message)
            for message in self.visible_messages[-limit:]
        ]

        for message in messages:
            if (
                not message.get("chat_identifier")
                and fallback_chat_identifier
            ):
                message["chat_identifier"] = (
                    fallback_chat_identifier
                )

        return messages

    def get_latest_chat_message(
        self,
        fallback_chat_identifier=""
    ):
        messages = self.get_visible_chat_messages(
            fallback_chat_identifier,
            limit=1
        )
        return messages[-1] if messages else None

    def find_unread_chat(self):
        if self.pending_unread_chat is None:
            return None

        self.last_unread_count = self.pending_unread_chat[
            "unread_count"
        ]
        return self.pending_unread_chat

    def open_chat(self, chat):
        self.current_chat_name = chat["chat_name"]
        self.visible_messages = [
            dict(message)
            for message in chat["visible_messages"]
        ]
        self.pending_unread_chat = None
        return True


def make_account(account_id):
    return ChannelAccount(
        id=account_id,
        client_id=5000 + account_id,
        platform="whatsapp",
        external_account_id=f"account-{account_id}",
        account_name=f"Burst account {account_id}",
        status="active",
    )


def verify_active_chat_burst():
    bot = FakeBurstBot()
    adapter = WhatsAppWebAdapter(
        account=make_account(81),
        session_path=(
            PROJECT_ROOT
            / "whatsapp_sessions"
            / "account_81"
        ),
        bot=bot,
    )
    adapter.start()

    # Startup history is primed and never emitted.
    assert tuple(adapter.poll_events()) == ()

    bot.visible_messages.extend(
        [
            bot.message(
                "rapid-a",
                "lid:burst-customer",
                "A",
            ),
            bot.message(
                "rapid-b",
                "lid:burst-customer",
                "B",
            ),
            bot.message(
                "rapid-c",
                "lid:burst-customer",
                "C",
            ),
        ]
    )

    events = tuple(adapter.poll_events())
    assert [event.content for event in events] == [
        "A",
        "B",
        "C",
    ]
    assert [
        event.external_message_id
        for event in events
    ] == [
        "rapid-a",
        "rapid-b",
        "rapid-c",
    ]
    assert tuple(adapter.poll_events()) == ()

    # Outbound/human-agent messages advance the cursor but are never normalized
    # as customer inbound events.
    bot.visible_messages.extend(
        [
            bot.message(
                "human-outbound",
                "lid:burst-customer",
                "Manual agent answer",
                direction="outbound",
            ),
            bot.message(
                "rapid-d",
                "lid:burst-customer",
                "D",
            ),
        ]
    )
    events = tuple(adapter.poll_events())
    assert [event.content for event in events] == ["D"]

    # Repeated text with two external IDs must produce two events.
    bot.visible_messages.extend(
        [
            bot.message(
                "same-text-1",
                "lid:burst-customer",
                "SAME",
            ),
            bot.message(
                "same-text-2",
                "lid:burst-customer",
                "SAME",
            ),
        ]
    )
    events = tuple(adapter.poll_events())
    assert len(events) == 2
    assert [event.content for event in events] == [
        "SAME",
        "SAME",
    ]
    assert [
        event.external_message_id
        for event in events
    ] == [
        "same-text-1",
        "same-text-2",
    ]

    adapter.stop()


def verify_unread_chat_burst():
    bot = FakeBurstBot()
    adapter = WhatsAppWebAdapter(
        account=make_account(82),
        session_path=(
            PROJECT_ROOT
            / "whatsapp_sessions"
            / "account_82"
        ),
        bot=bot,
    )
    adapter.start()

    bot.pending_unread_chat = {
        "chat_name": "Unread Burst Customer",
        # Reproduce the live WhatsApp behavior: the UI reports a binary unread
        # count of 1 even though three new messages follow the prior outbound.
        "unread_count": 1,
        "visible_messages": [
            bot.message(
                "unread-history",
                "lid:unread-customer",
                "Old history",
            ),
            bot.message(
                "prior-outbound",
                "lid:unread-customer",
                "Previous bot reply",
                direction="outbound",
            ),
            bot.message(
                "unread-1",
                "lid:unread-customer",
                "U1",
            ),
            bot.message(
                "unread-2",
                "lid:unread-customer",
                "U2",
            ),
            bot.message(
                "unread-3",
                "lid:unread-customer",
                "U3",
            ),
        ],
    }

    events = tuple(adapter.poll_events())
    assert [event.content for event in events] == [
        "U1",
        "U2",
        "U3",
    ]
    assert all(
        event.external_user_id
        == "lid:unread-customer"
        for event in events
    )
    assert tuple(adapter.poll_events()) == ()

    adapter.stop()


def main():
    verify_active_chat_burst()
    verify_unread_chat_burst()

    print("Active-chat rapid messages captured in order: 3/3")
    print("Unread-chat rapid messages captured in order: 3/3")
    print("Binary unread count=1 expanded via unanswered burst: 3/3")
    print("Outbound DOM messages skipped: 1")
    print("Repeated text with distinct external IDs preserved: 2/2")
    print("Second poll duplicates emitted: 0")
    print("\n✅ WHATSAPP BURST ADAPTER TEST PASSED")


if __name__ == "__main__":
    main()
